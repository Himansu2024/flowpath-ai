# ============================================================
# FlowPath AI - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database - PostgreSQL with PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowpath_db
DB_USER=flowpath_user
DB_PASSWORD=your_secure_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE=10000

# Redis (for caching & real-time state)
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AI Engine
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=your_ai_engine_api_key

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=flowpath-assets
AWS_CLOUDFRONT_URL=https://your-cloudfront-domain.cloudfront.net

# Google Maps (optional - OpenStreetMap used by default)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Socket.IO
SOCKET_CORS_ORIGIN=*
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/flowpath.log

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:8080
